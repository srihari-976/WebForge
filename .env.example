# WebForge Environment Configuration
# Copy this file to .env and adjust values as needed

# Ollama connection
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=180

# Model configuration (defaults shown)
WEBBUILDER_ORCHESTRATOR_MODEL=qwen2.5:1.5b
WEBBUILDER_REQUIREMENTS_MODEL=qwen2.5:3b
WEBBUILDER_PLANNER_MODEL=qwen2.5-coder:3b
WEBBUILDER_FRONTEND_MODEL=qwen2.5-coder:3b
WEBBUILDER_BACKEND_MODEL=qwen2.5-coder:3b
WEBBUILDER_DEBUGGER_MODEL=qwen2.5-coder:3b
WEBBUILDER_VALIDATOR_MODEL=qwen2.5-coder:3b

# Build behavior
WEBBUILDER_USE_CREWAI=true
WEBBUILDER_REQUIRE_CREWAI=false
WEBBUILDER_RETRY_LIMIT=2
WEBBUILDER_MAX_FILE_SIZE=500000

# Logging
# Set to true for verbose debug output
WEBBUILDER_VERBOSE=false
